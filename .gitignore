node_modules/
dist/
.next/
out/
# Every environment file, whatever it is called. The previous three lines
# covered .env, .env.local and .env.*.local but not .env.production or
# .env.vps — exactly the names a server deployment invites. One rule that
# catches all of them, with the committed template as the sole exception.
.env*
!.env.example
*.log
.DS_Store
coverage/

# TypeScript incremental build cache
*.tsbuildinfo

# Legacy PHP visiting-card site (imported into the app; contains live DB
# credentials in card/card/data.php and db-config.php — must not be committed)
/card/
