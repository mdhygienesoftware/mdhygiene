# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://gtpvibbeqlndkaezqniz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-dashboard

# --- Enquiry email notifications (optional) ---
# Without these, enquiries still save and appear in /admin/inquiries — only the
# email notification is skipped.
# API key from https://resend.com (Dashboard -> API Keys)
RESEND_API_KEY=
# Where enquiry notifications are delivered. Comma-separate for several inboxes.
INQUIRY_NOTIFICATION_TO=mdhygienesoftware@gmail.com
# Sender. Use onboarding@resend.dev until a domain is verified in Resend,
# then switch to something like "M.D. Hygiene <enquiries@mdhygiene.in>".
INQUIRY_NOTIFICATION_FROM=M.D. Hygiene <onboarding@resend.dev>
# Public site URL, used for the "Open in admin panel" button in the email.
# On the server this must be the real domain: pages are pre-rendered, so it is
# baked into every canonical URL, the sitemap and the JSON-LD at build time.
# `canonical_domain` in Admin → SEO overrides this; keep the two in agreement.
NEXT_PUBLIC_SITE_URL=https://mdhygiene.in

# --- Visitor counting (recommended on a server) ---
# Salts the hash that counts distinct visitors without storing anyone's IP.
# Left unset it is regenerated on every restart, and each restart starts a
# fresh salt — which counts the same person twice for the rest of that day.
# Any long random string; keep it stable.
ANALYTICS_SALT=
